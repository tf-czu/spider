{
  "version": 2,
  "robot": {
    "modules": {
      "local_map": {
        "driver": "robot.local_map:LocalMap",
        "in": ["scan", "pose3d"],
        "out": ["grid"],
        "init": {
          "size": 20,
          "resolution": 0.2,
          "lidar_range": 15,
          "angle_offset": -180,
          "flip_scan": false,
          "heading_aligned": false,
          "unknown_value": 1,
          "accumulate": true
        }
      }
    },
    "links": [
      ["scan.scan", "local_map.scan"],
      ["lsqr.pose3d", "local_map.pose3d"]
    ]
  }
}
