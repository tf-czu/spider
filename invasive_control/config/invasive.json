{
  "version": 2,
  "robot": {
    "modules": {

      "app": {
          "driver": "invasive_control.invasive:Invasive",
          "in": ["pose3d", "nmea_data", "pose2d", "scan"],
          "out": ["desired_steering"],
          "init": {
            "waypoints_file": "invasive_control/data/path_czu_3.json",
            "required_quality": 4,
            "straight_dist": 5,
            "sensor_wait_timeout": 10,
            "gps_recovery_timeout": 30,
            "fov_angle": 100,
            "stop_dist": 1.6,
            "slow_dist": 3.0
          }
      },

      "lsqr": {
	      "driver": "localization:Localization",
	      "in": ["nmea_data", "orientation", "encoders", "pose2d"],
	      "out": ["pose3d"],
	      "init":{
            "algorithm": "lsqr",
            "enc scale": 0.00218,
            "window": 2,
            "prune": 1,
            "post window": null,
            "initial angle": 0,
            "initial scale":  1.0,
            "initial window": 2.0,
            "initial dumb distance": 0.01
          }
      },

      "scan": {
        "driver": "robot.scan3d2scan:Scan3DToScan2D",
        "in": ["scan3d"],
        "out": ["scan"],
        "init": {
          "lidar_height": 1.3,
          "slope": 15,
          "lidar_range": 15,
          "obstacle_size" : 0.4,
          "blind_zone": 0.8,
          "flip_scan": true
        }
},

      "reset": {
        "driver": "robot.spider_reset:Reset",
        "init": {}
      },

       "transmitter": {
        "driver": "osgar.drivers.push:Push",
          "init": {
            "pubsub": true,
            "endpoint": "tcp://127.0.0.1:5556"
          }
      },

      "receiver": {
        "driver": "osgar.drivers.pull:Pull",
        "init": {
          "pubsub": true,
          "endpoint": "tcp://127.0.0.1:5555",
          "outputs": [
            "status", "encoders", "pose2d", "bumpers"
          ]
        }
      },

      "lidar": {
          "driver": "osgar.drivers.ouster_lidar:OusterLidar",
          "init": {
            "lidar_ip": "192.168.1.91",
            "lidar_mode": "MODE_1024x10",
            "azimuth_window": null
          }
      },

      "imu": {
          "driver": "imu",
          "in": ["raw"],
          "out": ["orientation", "rotation", "data"],
          "init": {}
      },
      "imu_tcp": {
          "driver": "tcp",
          "in": ["raw"],
          "out": ["raw"],
          "init": {
              "host": "192.168.1.12",
              "port": 10002,
              "bufsize": 2000
          }
      },

       "camera_front": {
          "driver": "osgar.drivers.oak_camera:OakCamera",
          "init": {
            "fps": 10,
            "is_color": true,
            "cam_id": "192.168.1.62",
            "color_resolution": "THE_800_P"
          }
      },

      "rtk_gps": {
        "driver": "gps",
        "init": {}
      },
      "rtk_gps_serial": {
        "driver": "serial",
        "in": ["raw"],
        "out": ["raw"],
        "init": {"port": "/dev/ttyACM1", "speed": 115200}
      }

    },
    "links": [
              ["app.desired_steering", "transmitter.desired_steering"],
              ["receiver.pose2d", "app.pose2d"],
              ["rtk_gps.nmea_data", "app.nmea_data"],
              ["lsqr.pose3d", "app.pose3d"],
              ["scan.scan", "app.scan"],

              ["lidar.scan3d", "scan.scan3d"],

              ["reset.reset", "transmitter.reset"],

              ["receiver.encoders", "lsqr.encoders"],
              ["imu.orientation", "lsqr.orientation"],
              ["rtk_gps.nmea_data", "lsqr.nmea"],

              ["imu_tcp.raw", "imu.raw"],
              ["rtk_gps_serial.raw", "rtk_gps.raw"]
    ]
  }
}
