{
  "version": 2,
  "robot": {
    "modules": {
      "gps": {
          "driver": "gps",
          "in": ["raw"],
          "out": ["position", "rel_position"],
          "init": {}
      },
      "gps_serial": {
          "driver": "serial",
          "in": [],
          "out": ["raw"],
          "init": {"port": "/dev/ttyACM1", "speed": 115200}
      }
    },
    "links": [["gps_serial.raw", "gps.raw"]]
  }
}

